node_modules/
dist/
.DS_Store
*.log

# Credentials — never commit these.
# Deny every .env variant, then re-allow only the committed templates, so a
# newly invented file like .env.cloudflare cannot be swept in by `git add -A`.
.env
.env.*
!.env.example
!.env.*.example

# Live position snapshots are generated by the scheduled workflow at deploy
# time and shipped straight into the Pages artifact — never committed.
public/data/live/
worker/.dev.vars

# Local worker secrets for `wrangler dev`.
.dev.vars
